module sh.sysl.xml

@tests

import sysl.buf.{Buf, buf}

// The tree reader: what each kind of markup becomes, and how a consumer finds its way around.

private doc(text: string) -> &Document = parse(text).expect(s"parses: $text")

// The error a document is refused with, as `line:col: message`, or "accepted".
private[xml] refusal(text: string) -> string
    parse(text) match
        Ok(_) -> "accepted"
        Err(e) -> e.to_string()
// The text of the root element of `<r>` + `body` + `</r>`.
private[xml] text_in(body: string) -> string = doc(s"<r>$body</r>").root.text()

// The value of attribute `a` on `<r a=...>`, with `quoted` written as it is, quotes included.
private[xml] attr_of(quoted: string) -> string = doc(s"<r a=$quoted/>").root.attr("a").unwrap()

@test("an element with attributes and text reads back as written")
element_attrs_text()
    val d = doc("<c r=\"B2\" s='1'><v>42</v></c>")

    assert_eq(d.root.local, "c")
    assert_eq(d.root.attr("r"), Some("B2"))
    assert_eq(d.root.attr("s"), Some("1"))
    assert_eq(d.root.attr("t"), None)
    assert_eq(d.root.child("v").map(e -> e.text()), Some("42"))
    assert_eq(d.root.child("w").is_none(), true)
    assert_eq(d.root.text(), "42")
end element_attrs_text

@test("the declaration's three fields are kept, and are empty where there was none")
declaration_fields()
    val d = doc("<?xml version=\"1.0\" encoding=\"utf-8\" standalone='yes' ?><r/>")

    assert_eq(d.version, "1.0")
    assert_eq(d.encoding, "utf-8")
    assert_eq(d.standalone, Some(true))
    assert_eq(doc("<?xml version='1.1'?><r/>").version, "1.1")
    assert_eq(doc("<?xml version='1.0' standalone=\"no\"?><r/>").standalone, Some(false))

    val bare = doc("<r/>")

    assert_eq(bare.version, "")
    assert_eq(bare.encoding, "")
    assert_eq(bare.standalone, None)
end declaration_fields

@test("a byte order mark is not part of the document, before a declaration or without one")
byte_order_mark()
    assert_eq(doc("\u{FEFF}<?xml version='1.0'?><r/>").version, "1.0")
    assert_eq(doc("\u{FEFF}<r>x</r>").root.text(), "x")
    assert_eq(parse_bytes([0xEF, 0xBB, 0xBF, u8('<'), u8('r'), u8('/'), u8('>')]).map(d -> d.root.local), Ok("r"))
@test("the prolog and epilog keep their comments and processing instructions, in order")
prolog_and_epilog()
    val d = doc("<?xml version='1.0'?>\n<!--a--><?p x?>\n<!DOCTYPE r>\n<r/>\n<!--b-->\n")

    assert_eq(d.doctype, "r")
    assert_eq(d.children.len(), 4)
    assert_eq(d.children[0], Node.Comment("a"))
    assert_eq(d.children[1], Node.Pi("p", "x"))
    assert_eq(d.children[3], Node.Comment("b"))

    d.children[2] match
        Elem(e) -> assert_eq(e.local, "r")
        _ -> assert(false, "the root is the third child")
end prolog_and_epilog

@test("navigation: elements, elements by name, first child by name, and the string value")
navigation()
    val d = doc("<sheetData>\n <row r='1'><c r='A1'><v>1</v></c><c r='B1'><v>2</v></c></row>\n <!-- x -->\n <row r='2'/>\n <other/>\n</sheetData>")
    val rows = d.root.elements_named("row")

    assert_eq(rows.len(), 2)
    assert_eq(rows[1].attr("r"), Some("2"))
    assert_eq(d.root.elements().len(), 3)
    assert_eq(rows[0].elements_named("c")[1].attr("r"), Some("B1"))
    assert_eq(rows[0].text(), "12")
    assert_eq(d.root.child("other").map(e -> e.local), Some("other"))
    assert_eq(d.root.elements_named("nothing").len(), 0)
end navigation

@test("text() joins text and CDATA through every depth, and skips comments and PIs")
string_value()
    assert_eq(text_in("a<b>b<c>c</c></b><![CDATA[<d>]]><!--no--><?no?>e"), "abc<d>e")
    assert_eq(text_in(""), "")
    assert_eq(text_in("<x/>"), "")
    assert_eq(text_in("<![CDATA[only]]>"), "only")
@test("the five predefined entities are replaced, in text and in attributes")
predefined_entities()
    assert_eq(text_in("&lt;&gt;&amp;&apos;&quot;"), "<>&'\"")
    assert_eq(attr_of("\"&lt;&gt;&amp;&apos;&quot;\""), "<>&'\"")
    assert_eq(text_in("a&amp;amp;b"), "a&amp;b")
@test("character references: decimal and hex, at the ends of the range, UTF-8 encoded")
character_references()
    assert_eq(text_in("&#65;&#x42;&#x0043;&#0068;"), "ABCD")
    assert_eq(text_in("&#x10FFFF;").bytes, [0xF4, 0x8F, 0xBF, 0xBF])
    assert_eq(text_in("&#xE9;&#233;"), "éé")
    assert_eq(text_in("&#x1F600;"), "😀")
    assert_eq(text_in("&#9;&#xA;&#xD;"), "\t\n\r")
    assert_eq(text_in("&#x20;&#xD7FF;&#xE000;&#xFFFD;&#x10000;").len, 1 + 3 + 3 + 3 + 4)
    assert_eq(attr_of("'&#x41;&#10;'"), "A\n")
end character_references

@test("a character reference to anything XML does not allow is refused, where it is")
bad_character_references()
    assert_eq(refusal("<r>&#xD800;</r>"), "1:4: `&#xD800;` does not name a character XML allows")
    assert_eq(refusal("<r>&#xDFFF;</r>"), "1:4: `&#xDFFF;` does not name a character XML allows")
    assert_eq(refusal("<r>&#0;</r>"), "1:4: `&#0;` does not name a character XML allows")
    assert_eq(refusal("<r>&#x110000;</r>"), "1:4: `&#x110000;` does not name a character XML allows")
    assert_eq(refusal("<r>&#xFFFE;</r>"), "1:4: `&#xFFFE;` does not name a character XML allows")
    assert_eq(refusal("<r>&#xFFFF;</r>"), "1:4: `&#xFFFF;` does not name a character XML allows")
    assert_eq(refusal("<r>&#x1F;</r>"), "1:4: `&#x1F;` does not name a character XML allows")
    assert_eq(refusal("<r a='&#8;'/>"), "1:7: `&#8;` does not name a character XML allows")
    assert_eq(refusal("<r>&#99999999999999999999999;</r>").starts_with("1:4: a character reference is"), true)
    assert_eq(refusal("<r>&#;</r>"), "1:4: a character reference is `&#` and decimal digits, or `&#x` and hex digits, then `;`")
    assert_eq(refusal("<r>&#x;</r>"), "1:4: a character reference is `&#` and decimal digits, or `&#x` and hex digits, then `;`")
    assert_eq(refusal("<r>&#X41;</r>"), "1:4: a character reference is `&#` and decimal digits, or `&#x` and hex digits, then `;`")
    assert_eq(refusal("<r>&#4_1;</r>"), "1:4: a character reference may not have `_` in its digits")
    assert_eq(refusal("<r>&#x4G;</r>"), "1:8: expected `;` to end the character reference, found `G`")
    assert_eq(refusal("<r>&#65</r>"), "1:8: expected `;` to end the character reference, found `<`")
end bad_character_references

@test("an `&` that does not begin a reference, and an entity XML does not predefine, are refused")
bad_entity_references()
    assert_eq(refusal("<r>a & b</r>"), "1:6: `&` must begin a reference such as `&amp;` or `&#38;`; write `&amp;` for an ampersand")
    assert_eq(refusal("<r a='&'/>"), "1:7: `&` must begin a reference such as `&amp;` or `&#38;`; write `&amp;` for an ampersand")
    assert_eq(refusal("<r>&amp</r>"), "1:8: expected `;` to end the reference `&amp`, found `<`")
    assert_eq(refusal("<r>&nbsp;</r>"), "1:4: `&nbsp;` is not one of XML's five entities (`lt`, `gt`, `amp`, `apos`, `quot`)")
    assert_eq(refusal("<!DOCTYPE r [<!ENTITY e 'x'>]><r>&e;</r>"),
        "1:34: `&e;` is not one of XML's five entities; entities declared in a DOCTYPE are not expanded by this reader")
end bad_entity_references

@test("line ends are normalised to `\\n`: CRLF and a lone CR, in text, CDATA, comments and PIs")
line_end_normalisation()
    assert_eq(text_in("a\r\nb\rc\n\rd\r\r\ne"), "a\nb\nc\n\nd\n\ne")
    assert_eq(text_in("<![CDATA[a\r\nb\rc]]>"), "a\nb\nc")
    assert_eq(doc("<r><!--a\r\nb--></r>").root.children[0], Node.Comment("a\nb"))
    assert_eq(doc("<r><?p a\rb?></r>").root.children[0], Node.Pi("p", "a\nb"))
    assert_eq(text_in("\r"), "\n")
    assert_eq(text_in("x\r"), "x\n")
    assert_eq(text_in("&#13;\r\n"), "\r\n")
end line_end_normalisation

@test("an attribute value's whitespace becomes spaces, a line end being one; references keep theirs")
attribute_normalisation()
    assert_eq(attr_of("\"a\tb\nc\r\nd\re\""), "a b c d e")
    assert_eq(attr_of("'  two  spaces  '"), "  two  spaces  ")
    assert_eq(attr_of("'&#9;&#10;&#13;&#32;'"), "\t\n\r ")
    assert_eq(attr_of("'\"'"), "\"")
    assert_eq(attr_of("\"'\""), "'")
    assert_eq(attr_of("''"), "")
    assert_eq(attr_of("'>'"), ">")
    assert_eq(attr_of("'a&amp;\tb'"), "a& b")
    assert_eq(attr_of("'a\r'"), "a ")
    assert_eq(attr_of("'\r\n\r\n'"), "  ")
end attribute_normalisation

@test("text that held nothing to replace is the input's own bytes")
shared_slices()
    // Not a property a caller can see, except in what it costs -- which is why it is asserted on the
    // one path that would otherwise copy: a reference earlier in the same document must not leave the
    // builder in copying mode for a later run.
    val d = doc("<r a='x&amp;y' b='plain'>t&lt;u<s>plain</s></r>")

    assert_eq(d.root.attr("a"), Some("x&y"))
    assert_eq(d.root.attr("b"), Some("plain"))
    assert_eq(d.root.child("s").unwrap().text(), "plain")
    assert_eq(d.root.children[0], Node.Text("t<u"))
end shared_slices

@test("CDATA keeps markup characters as text, and `]]` that does not close it")
cdata_sections()
    assert_eq(doc("<r><![CDATA[<a>&amp;]]></r>").root.children[0], Node.CData("<a>&amp;"))
    assert_eq(text_in("<![CDATA[]]]]>"), "]]")
    assert_eq(text_in("<![CDATA[]]>"), "")
    assert_eq(text_in("<![CDATA[a]b]]c]]>"), "a]b]]c")
@test("`]]>` in text is refused, and a `]` or `]]` that is not followed by `>` is not")
cdata_end_in_text()
    assert_eq(refusal("<r>a]]>b</r>"), "1:5: `]]>` is not allowed in text; write `]]&gt;`")
    assert_eq(text_in("a]b]]c]"), "a]b]]c]")
    assert_eq(text_in("]]&gt;"), "]]>")
    assert_eq(refusal("<r>]]"), "1:6: the input ended inside `<r>`, opened at 1:1")
    assert_eq(refusal("<r>\u{F000}"), "1:5: the input ended inside `<r>`, opened at 1:1")
    assert_eq(refusal("<r>&#x41;"), "1:10: the input ended inside `<r>`, opened at 1:1")
@test("comments: empty, with single dashes, and refused with `--` or ending in `-`")
comments()
    assert_eq(doc("<r><!----></r>").root.children[0], Node.Comment(""))
    assert_eq(doc("<r><!-- a - b --></r>").root.children[0], Node.Comment(" a - b "))
    assert_eq(refusal("<r><!-- a -- b --></r>"), "1:11: `--` is not allowed inside a comment")
    assert_eq(refusal("<r><!-- a ---></r>"), "1:11: `--` is not allowed inside a comment")
    assert_eq(refusal("<r><!-- a </r>"), "1:4: the comment is not closed; the input ended inside it")
end comments

@test("processing instructions: data, none, and the reserved target")
processing_instructions()
    assert_eq(doc("<r><?go now ?></r>").root.children[0], Node.Pi("go", "now "))
    assert_eq(doc("<r><?go?></r>").root.children[0], Node.Pi("go", ""))
    assert_eq(doc("<r><?go   ?></r>").root.children[0], Node.Pi("go", ""))
    assert_eq(doc("<r><?xml-stylesheet href='a'?></r>").root.children[0], Node.Pi("xml-stylesheet", "href='a'"))
    assert_eq(refusal("<r><?XmL x?></r>"), "1:4: `XmL` is reserved and may not be a processing-instruction target")
    assert_eq(refusal("<r/><?xml version='1.0'?>"), "1:5: the XML declaration is only allowed at the very start of the document")
    assert_eq(refusal(" <?xml version='1.0'?><r/>"), "1:2: the XML declaration is only allowed at the very start of the document")
    assert_eq(refusal("<r><?go-now?></r>"), "accepted")
    assert_eq(refusal("<r><?go\"x\"?></r>"), "1:8: expected whitespace or `?>` after the target, found `\"`")
    assert_eq(refusal("<r><?a:b c?></r>"), "1:6: `a:b` is not a processing-instruction target: under namespaces it may not hold a colon")
    assert_eq(refusal("<r><?p x"), "1:4: the processing instruction is not closed; the input ended inside it")
end processing_instructions

@test("the XML declaration's mistakes are each refused where they are")
declaration_errors()
    assert_eq(refusal("<?xml version='2.0'?><r/>"), "1:1: `2.0` is not an XML 1.x version number")
    assert_eq(refusal("<?xml encoding='UTF-8'?><r/>"), "1:7: expected `version` in the XML declaration at 1:1, found `e`")
    assert_eq(refusal("<?xml version='1.0' encoding='latin1'?><r/>"),
        "1:21: the encoding `latin1` is not supported; this reader takes UTF-8 (and US-ASCII, which is part of it)")
    assert_eq(refusal("<?xml version='1.0' standalone='maybe'?><r/>"), "1:21: `standalone` is `yes` or `no`, not `maybe`")
    assert_eq(refusal("<?xml version='1.0'encoding='UTF-8'?><r/>"), "1:20: expected whitespace before `encoding`, found `e`")
    assert_eq(refusal("<?xml version='1.0' standalone='yes' encoding='UTF-8'?><r/>"), "1:38: expected `?>` to end the XML declaration, found `e`")
    assert_eq(refusal("<?xml version='1.0'"), "1:20: expected `?>` to end the XML declaration, found the end of the input")
    assert_eq(refusal("<?xml version = \"1.0\" ?><r/>"), "accepted")
end declaration_errors

@test("mismatched and unclosed tags are refused, naming where the open one began")
tag_structure_errors()
    assert_eq(refusal("<a><b></a></b>"), "1:7: `</a>` does not close `<b>`, opened at 1:4")
    assert_eq(refusal("<a>\n  <b>\n</a>"), "3:1: `</a>` does not close `<b>`, opened at 2:3")
    assert_eq(refusal("<a><b>"), "1:7: the input ended inside `<b>`, opened at 1:4")
    assert_eq(refusal("<a>text"), "1:8: the input ended inside `<a>`, opened at 1:1")
    assert_eq(refusal("<a></a></a>"), "1:8: `</a>` closes an element that was never opened")
    assert_eq(refusal("<a/><b/>"), "1:5: a second root element; a document has exactly one")
    assert_eq(refusal("<a></a >"), "accepted")
    assert_eq(refusal("<a></a b>"), "1:8: expected `>` to end `</a`, found `b`")
    assert_eq(refusal("<a"), "1:1: the input ended inside the start tag `<a`")
    assert_eq(refusal("<a b='1'"), "1:1: the input ended inside the start tag `<a`")
end tag_structure_errors

@test("the document around the root: no root, text outside it, a misplaced DOCTYPE or CDATA")
document_structure_errors()
    assert_eq(refusal(""), "1:1: expected the root element, found the end of the input")
    assert_eq(refusal("  \n "), "2:2: expected the root element, found the end of the input")
    assert_eq(refusal("<!-- only -->"), "1:14: expected the root element, found the end of the input")
    assert_eq(refusal("x<r/>"), "1:1: text is not allowed before the root element; a document's text is inside its root element")
    assert_eq(refusal("<r/>x"), "1:5: text is not allowed after the root element; a document's text is inside its root element")
    assert_eq(refusal("<r/>&amp;"), "1:5: text is not allowed after the root element; a document's text is inside its root element")
    assert_eq(refusal("<r/><!DOCTYPE r>"), "1:5: a DOCTYPE is only allowed before the root element")
    assert_eq(refusal("<!DOCTYPE r><!DOCTYPE r><r/>"), "1:13: a document has at most one DOCTYPE")
    assert_eq(refusal("<r><!DOCTYPE r></r>"), "1:4: a DOCTYPE is only allowed before the root element")
    assert_eq(refusal("<![CDATA[x]]><r/>"), "1:1: a CDATA section is not allowed outside the root element")
    assert_eq(refusal("<r><!x></r>"), "1:4: expected `<!--`, `<![CDATA[` or `<!DOCTYPE` after `<!`")
    assert_eq(refusal("<r/>\n\n"), "accepted")
end document_structure_errors

@test("attributes: duplicates, `<` in a value, a missing `=` or quote, and no space between")
attribute_errors()
    assert_eq(refusal("<r a='1' a='2'/>"), "1:10: the attribute `a` is given twice in one start tag")
    assert_eq(refusal("<r a='1' b='2' a=\"3\"/>"), "1:16: the attribute `a` is given twice in one start tag")
    assert_eq(refusal("<r a='<'/>"), "1:7: `<` is not allowed in an attribute value; write `&lt;`")
    assert_eq(refusal("<r a '1'/>"), "1:6: expected `=` after the attribute name `a`, found `'`")
    assert_eq(refusal("<r a=1/>"), "1:6: expected a quoted attribute value, found `1`")
    assert_eq(refusal("<r a='1'b='2'/>"), "1:9: expected whitespace, `>` or `/>`, found `b`")
    assert_eq(refusal("<r a='1/>"), "1:6: the attribute value is not closed; the input ended inside it")
    assert_eq(refusal("<r a=\"1'/>"), "1:6: the attribute value is not closed; the input ended inside it")
    assert_eq(refusal("<r 1a='1'/>"), "1:4: expected an attribute name, `>` or `/>`, found `1`")
end attribute_errors

@test("names: what may start one, what may continue one, and names above ASCII")
names()
    assert_eq(refusal("<1r/>"), "1:2: expected an element name after `<`, found `1`")
    assert_eq(refusal("<-r/>"), "1:2: expected an element name after `<`, found `-`")
    assert_eq(refusal("< r/>"), "1:2: expected an element name after `<`, found ` `")
    assert_eq(refusal("<r\u{B7}x/>"), "accepted")
    assert_eq(refusal("<\u{B7}r/>"), "1:2: expected an element name after `<`, found `\u{B7}`")
    assert_eq(doc("<日本語 属性='値'/>").root.attr("属性"), Some("値"))
    assert_eq(doc("<_a.b-c9/>").root.local, "_a.b-c9")
    assert_eq(refusal("<r\u{37E}/>"), "1:3: expected whitespace, `>` or `/>`, found `\u{37E}`")
    assert_eq(refusal("<r>\u{1}</r>"), "1:4: the control character U+0001 is not allowed in XML")
    assert_eq(refusal("<r a='\u{1F}'/>"), "1:7: the control character U+001F is not allowed in XML")
    assert_eq(refusal("<r>\u{FFFE}</r>"), "1:4: U+FFFE is not a character XML allows")
    assert_eq(refusal("<r><!--\u{FFFF}--></r>"), "1:8: U+FFFF is not a character XML allows")
    assert_eq(text_in("\u{FFFD}\u{F000}"), "\u{FFFD}\u{F000}")
end names

@test("a DOCTYPE is checked for its shape and its contents are stepped over")
doctypes()
    assert_eq(doc("<!DOCTYPE r SYSTEM 'r.dtd'><r/>").doctype, "r")
    assert_eq(doc("<!DOCTYPE r PUBLIC \"-//A//B//EN\" 'r.dtd' [ <!ELEMENT r ANY> ]><r/>").doctype, "r")
    assert_eq(doc("<!DOCTYPE r [<!-- ]> --><?p ]>?><!ATTLIST r a CDATA '>]'>%pe;]><r/>").root.local, "r")
    assert_eq(refusal("<!DOCTYPE r PUBLIC '{' 'x'><r/>"), "1:21: `{` is not allowed in a public identifier")
    assert_eq(refusal("<!DOCTYPE r SYSTEM><r/>"), "1:19: expected whitespace and a quoted literal, found `>`")
    assert_eq(refusal("<!DOCTYPE r [<!FOO>]><r/>"), "1:16: expected `ELEMENT`, `ATTLIST`, `ENTITY` or `NOTATION` after `<!`, found `F`")
    assert_eq(refusal("<!DOCTYPE r [ x ]><r/>"), "1:15: expected a markup declaration, `]` or a comment in the internal subset, found `x`")
    assert_eq(refusal("<!DOCTYPE r [<!ELEMENT r ANY>"), "1:1: the DOCTYPE's internal subset is not closed; the input ended inside it")
    assert_eq(refusal("<!DOCTYPE r [] x><r/>"), "1:16: expected `>` to end the DOCTYPE, found `x`")
    assert_eq(refusal("<!DOCTYPE r [<?xml version='1.0'?>]><r/>"), "1:14: the XML declaration is only allowed at the very start of the document")
    assert_eq(refusal("<!DOCTYPE"), "1:10: expected whitespace after `<!DOCTYPE`, found the end of the input")
end doctypes

@test("input that is not UTF-8 is refused at the first bad byte, with its line")
not_utf8()
    val bytes: [8]u8 = [u8('<'), u8('r'), u8('>'), u8('\n'), u8('a'), 0xFF, u8('<'), u8('/')]

    assert_eq(parse_bytes(bytes).map(d -> d.root.local).map_err(e -> e.to_string()),
        Err("2:2: the document is not UTF-8 here; this reader takes UTF-8 only"))
    assert_eq(text_of(bytes[0..<5]).map_err(e -> e.offset), Ok("<r>\na"))
end not_utf8

@test("an error carries its byte offset as well as its line and column, counted in characters")
error_positions()
    parse("<é>\n  <ü></é>") match
        Ok(_) -> assert(false, "refused")
        Err(e) ->
            assert_eq(e.line, 2)
            assert_eq(e.col, 6)
            assert_eq(e.offset, 11)
end error_positions
